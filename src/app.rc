#include "resource.h"

IDI_APP_ICON ICON "app.ico"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "m417z / standalone build"
            VALUE "FileDescription", "Slick Window Arrangement (standalone)"
            VALUE "FileVersion", "1.0.2.0"
            VALUE "InternalName", "SlickWindowArrangement"
            VALUE "OriginalFilename", "SlickWindowArrangement.exe"
            VALUE "ProductName", "Slick Window Arrangement"
            VALUE "ProductVersion", "1.0.2.0"
            VALUE "LegalCopyright", "GPLv3; original mod by m417z"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
